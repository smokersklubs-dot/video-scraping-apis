{
  "name": "@sklubs/box-configurator",
  "version": "0.1.0",
  "private": true,
  "description": "SKLUBS Box Configurator — moteur paramétrique 2D/3D de boîtes personnalisées",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
